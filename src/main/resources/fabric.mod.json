{
	"schemaVersion": 1,
	"id": "ahrivaea",
	"version": "${version}",
	"name": "Ahrivaea (all mods, for development)",
	"description": "A creature-collecting mod: catch, train and battle creatures.",
	"authors": [
		"jeffreystu10"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/ahrivaea/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.ahrivaea.Ahrivaea",
			"dev.ahrivaea.challenge.TowersMod",
			"dev.ahrivaea.stellar.StellarMod",
			"dev.ahrivaea.horses.HorsesMod",
			"dev.ahrivaea.minecarts.MinecartsMod",
			"dev.ahrivaea.woodcutting.WoodcuttingMod",
			"dev.ahrivaea.guilds.GuildsMod",
			"dev.ahrivaea.lights.LightsMod",
			"dev.ahrivaea.map.MapMod"
		],
		"client": [
			"dev.ahrivaea.client.AhrivaeaClient",
			"dev.ahrivaea.horses.client.HorsesClient",
			"dev.ahrivaea.guide.GuideClient",
			"dev.ahrivaea.minecarts.client.MinecartsClient",
			"dev.ahrivaea.map.client.MapClient"
		]
	},
	"mixins": [
		"ahrivaea.mixins.json",
		"ahrivaea_stellar.mixins.json",
		"ahrivaea_horses.mixins.json",
		"ahrivaea_minecarts.mixins.json",
		"ahrivaea_towers.mixins.json",
		{
			"config": "ahrivaea.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "ahrivaea_horses.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
